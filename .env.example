# Supabase — get these from https://supabase.com/dashboard/project/<your-project>/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# xneelo mailbox used by /api/contact (set these in Vercel → Settings → Environment Variables)
SMTP_HOST=smtp.yourdomain.co.za
SMTP_PORT=465
SMTP_USER=info@yourdomain.co.za
SMTP_PASS=your-mailbox-password
# Optional: deliver enquiries to a different address (defaults to SMTP_USER)
CONTACT_TO=
